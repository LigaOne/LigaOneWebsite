# Diese Werte NICHT hier eintragen, sondern in Vercel:
# Project → Settings → Environment Variables (für "Production" und "Preview")

# SMTP-Zugang des Postfachs, über das die Anfragen verschickt werden
SMTP_HOST=mail.liga-one-gmbh.ch
SMTP_PORT=465
SMTP_USER=info@liga-one-gmbh.ch
SMTP_PASS=

# Absender (muss zum SMTP-Konto passen) und Empfänger der Anfragen
MAIL_FROM=info@liga-one-gmbh.ch
MAIL_TO=info@liga-one-gmbh.ch
